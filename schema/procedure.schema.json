{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-intern.local/schema/procedure.schema.json",
  "title": "Procedure",
  "description": "Определение процедуры (иммутабельно). Мутабельная статистика — в state/<id>.yaml",
  "type": "object",
  "required": ["schema_version", "id", "title", "steps", "criteria", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^P[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "default": "" },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "keywords": { "type": "array", "items": { "type": "string" }, "default": [] },
    "owner": { "type": "string", "default": "" },
    "status": { "enum": ["active", "non-working"] },
    "deprecated_note": { "type": "string", "default": "" },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "type": { "enum": ["host", "path", "port", "url", "id", "secret", "text"] },
          "is_variable": { "type": "boolean", "default": true },
          "example": { "type": "string", "default": "" },
          "note": { "type": "string", "default": "" }
        }
      },
      "default": []
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "description"],
        "additionalProperties": false,
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "type": { "enum": ["bash", "agent"], "default": "bash" },
          "command": { "type": "string" },
          "instructions": { "type": "string" },
          "requires_confirmation": { "type": "boolean", "default": false },
          "check": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["exit_code", "regex", "http_status"] },
              "value": { "type": ["integer", "string"] }
            }
          }
        },
        "if": {
          "anyOf": [
            { "not": { "required": ["type"] } },
            { "properties": { "type": { "const": "bash" } }, "required": ["type"] }
          ]
        },
        "then": { "required": ["command"] },
        "else": { "required": ["instructions"] }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^P[0-9]{3,}$" }, "default": [] },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["exit_code", "regex", "http_status"] },
          "value": { "type": ["integer", "string"] }
        }
      }
    },
    "timeout_seconds": { "type": "integer", "minimum": 1, "default": 600 },
    "max_steps": { "type": "integer", "minimum": 1, "default": 20 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
